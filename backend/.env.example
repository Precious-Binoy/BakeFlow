# BakeFlow Backend Environment Variables
# Copy this file to .env and fill in your values

NODE_ENV=development
PORT=5000

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=bakeflow_db

# Session / Cookie Secret (use a long random string)
COOKIE_SECRET=change_this_to_a_long_random_secret_string

# CORS origin (frontend URL)
CORS_ORIGIN=http://localhost:5173

# Initial Admin (used by setup script only)
ADMIN_FULL_NAME=BakeFlow Administrator
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@bakeflow.local
ADMIN_PASSWORD=Admin@1234
